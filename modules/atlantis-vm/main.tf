# atlantis-vm module
#
# Provisions one self-contained Atlantis runtime:
#   - VPC network + NAT-less egress (no external IPs needed for egress in
#     GCP default behaviour; we keep a public IP for the HTTPS endpoint)
#   - Dedicated runtime GSA (never the default Compute Engine SA)
#   - Shielded e2-small VM with Debian 13 (trixie), Docker via startup script
#   - Persistent 10 GB data disk mounted at /etc/atlantis
#   - Secret Manager secrets for env-file, compose.yaml, repos.yaml, Caddyfile
#     and the instance-specific GitHub credentials
#   - Firewall: 80 and 443 open (ACME and HTTPS), 4141 NOT exposed,
#     IAP-only SSH (35.235.240.0/20)
#
# GitHub App credentials (app id, key, webhook secret) are NOT passed as
# Terraform variables: create the GitHub App manually, then store the values
# in the secrets this module pre-creates. The startup script and compose file
# read them at runtime.

locals {
  region         = var.region
  network_name   = "${var.name_prefix}-network"
  subnet_name    = "${var.name_prefix}-subnet"
  fw_allow_https = "${var.name_prefix}-allow-https"
  fw_allow_ssh   = "${var.name_prefix}-allow-iap-ssh"
  fw_deny_4141   = "${var.name_prefix}-deny-4141"
  vm_name        = "${var.name_prefix}-vm"
  data_disk_name = "${var.name_prefix}-data"

  # Secrets that hold the deployment configuration (non-credential files).
  config_secret_names = [
    "atlantis-${var.env}-env-file",
    "atlantis-${var.env}-compose",
    "atlantis-${var.env}-repos-yaml",
    "atlantis-${var.env}-caddyfile",
  ]

  # Secrets that hold GitHub App credentials, filled manually after the app is
  # created. Kept separate from config so they can be rotated independently.
  github_secret_names = [
    "atlantis-${var.env}-gh-app-id",
    "atlantis-${var.env}-gh-app-key",
    "atlantis-${var.env}-gh-webhook-secret",
  ]
}

# --- Runtime service account ---------------------------------------------------
# Dedicated identity, no default Compute Engine SA, no keys, no editor role.
# account_id is pinned so the SA email matches the spec:
#   nonprod -> atlantis-nonprod@<project>
#   prod    -> atlantis-prod@<project>
resource "google_service_account" "runtime" {
  account_id   = var.env == "prod" ? "atlantis-prod" : "atlantis-nonprod"
  project      = var.project_id
  display_name = "Atlantis runtime (${var.env})"
  description  = "Identity of the Atlantis ${var.env} Compute Engine VM. Impersonation targets are bound separately."
}

# --- Network ------------------------------------------------------------------
resource "google_compute_network" "this" {
  name                    = local.network_name
  project                 = var.project_id
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "this" {
  name                     = local.subnet_name
  project                  = var.project_id
  region                   = local.region
  network                  = google_compute_network.this.id
  ip_cidr_range            = var.subnet_cidr
  private_ip_google_access = true
}

# HTTP for ACME challenges and HTTPS for webhooks and the dashboard.
resource "google_compute_firewall" "allow_https" {
  name          = local.fw_allow_https
  project       = var.project_id
  network       = google_compute_network.this.name
  source_ranges = ["0.0.0.0/0"]
  allow {
    protocol = "tcp"
    ports    = ["80", "443"]
  }
  target_tags = ["atlantis-${var.env}"]
}

# SSH ONLY via Identity-Aware Proxy (source 35.235.240.0/20), never from the
# open internet.
resource "google_compute_firewall" "allow_iap_ssh" {
  name          = local.fw_allow_ssh
  project       = var.project_id
  network       = google_compute_network.this.name
  source_ranges = ["35.235.240.0/20"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
  target_tags = ["atlantis-${var.env}"]
}

# Explicit deny for the Atlantis backend port: belt and braces. Port 4141 must
# never be publicly reachable; Atlantis binds to 127.0.0.1 on the host.
resource "google_compute_firewall" "deny_4141" {
  name          = local.fw_deny_4141
  project       = var.project_id
  network       = google_compute_network.this.name
  source_ranges = ["0.0.0.0/0"]
  priority      = 900
  deny {
    protocol = "tcp"
    ports    = ["4141"]
  }
  target_tags = ["atlantis-${var.env}"]
  depends_on  = [google_compute_network.this]
}

# --- Persistent data disk ------------------------------------------------------
resource "google_compute_disk" "data" {
  name    = local.data_disk_name
  project = var.project_id
  zone    = var.zone
  type    = "pd-balanced"
  size    = 10
}

# --- Secrets (empty placeholders; filled manually) -----------------------------
# The deployment files are generated by the operator from deployments/<env>/
# and pushed here; nothing secret ever lives in Terraform state or variables.
resource "google_secret_manager_secret" "config" {
  for_each = toset(local.config_secret_names)

  project   = var.project_id
  secret_id = each.value
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret" "github" {
  for_each = toset(local.github_secret_names)

  project   = var.project_id
  secret_id = each.value
  replication {
    auto {}
  }
}

# Runtime GSA can read ONLY this environment's secrets (per-secret grants).
# PRO secrets are in a different project, so cross-environment access is
# impossible by construction.
resource "google_secret_manager_secret_iam_member" "runtime_accessor" {
  for_each = {
    for name, secret in merge(google_secret_manager_secret.config, google_secret_manager_secret.github) :
    name => secret.id
  }

  project   = var.project_id
  secret_id = each.key
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.runtime.email}"
}

# --- VM -------------------------------------------------------------------------
resource "google_compute_instance" "this" {
  name         = local.vm_name
  project      = var.project_id
  zone         = var.zone
  machine_type = var.machine_type

  boot_disk {
    initialize_params {
      image = var.boot_image
      size  = var.boot_disk_size_gb
      type  = "pd-balanced"
    }
  }

  attached_disk {
    source      = google_compute_disk.data.self_link
    device_name = "atlantis-data"
  }

  network_interface {
    subnetwork = google_compute_subnetwork.this.id
    # Ephemeral public IP for the HTTPS endpoint (Caddy ACME TLS).
    access_config {}
  }

  # Dedicated runtime GSA; the default Compute Engine SA is never used.
  service_account {
    email  = google_service_account.runtime.email
    scopes = ["https://www.googleapis.com/auth/cloud-platform"]
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  metadata = {
    # This script runs on first boot AND on every reboot (google-startup-script
    # metadata key runs at every boot), enabling reboot recovery.
    startup-script = templatefile("${path.module}/startup.sh.tftpl", {
      env = var.env
    })
    # SSH restricted to OS Login + IAP (firewall allows only 35.235.240.0/20).
    enable-oslogin = "TRUE"
  }

  tags = ["atlantis-${var.env}"]

  labels = {
    component = "atlantis"
    env       = var.env
  }

  # Recreate on metadata/startup changes only when explicitly forced.
  lifecycle {
    ignore_changes = [attached_disk]
  }
}

# Allow the VM GSA to log in via OS Login (IAP-tunnelled SSH only).
resource "google_project_iam_member" "oslogin" {
  count = var.enable_oslogin ? 1 : 0

  project = var.project_id
  role    = "roles/compute.osLogin"
  member  = "serviceAccount:${google_service_account.runtime.email}"
}
