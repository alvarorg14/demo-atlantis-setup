# Atlantis NoPRO environment file.
# The real .env is pushed to Secret Manager as `atlantis-nonprod-env-file`
# (see README — never committed to Git). Values below use placeholders.
#
# GitHub App credentials come from the dedicated secrets
# (atlantis-nonprod-gh-app-id / -gh-app-key / -gh-webhook-secret / -gh-user /
# -gh-token) and are fetched by the startup script; they are NOT duplicated
# in this file.

# --- Atlantis core ---
ATLANTIS_ATLANTIS_URL=https://atlantis-nonprod.alvarorg.com
ATLANTIS_PORT=4141
ATLANTIS_LOG_LEVEL=info

# --- GitHub App (values fetched at runtime by the startup script from
# --- atlantis-nonprod-gh-app-id / -gh-app-key / -gh-webhook-secret) ---
ATLANTIS_GH_HOSTNAME=github.com

# --- Repository access control ---
ATLANTIS_REPO_ALLOWLIST=github.com/alvarorg14/demo-atlantis-gsa
ATLANTIS_REPO_CONFIG=/etc/atlantis/repos.yaml

# --- Command trigger name for this instance ---
ATLANTIS_EXECUTABLE_NAME=atlantis-nonprod

# --- Security flags ---
ATLANTIS_ALLOW_FORK_PRS=false
ATLANTIS_DISABLE_APPLY_ALL=true
ATLANTIS_SILENCE_NO_PROJECTS=true
ATLANTIS_HIDE_PREV_PLAN_COMMENTS=true
ATLANTIS_WEBHOOK_HTTP_HEADERS={}
