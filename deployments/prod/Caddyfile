# Caddy reverse proxy for Atlantis PRO.
# Terminates TLS with an automatically managed Let's Encrypt certificate and
# forwards to Atlantis on the loopback-only port 4141.

atlantis-prod.alvarorg.com {
	encode gzip

	reverse_proxy atlantis-prod:4141 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		-Server
	}
}
