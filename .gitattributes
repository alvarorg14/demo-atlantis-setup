# Normalize line endings. Shell scripts and the VM startup template MUST stay
# LF even on Windows checkouts (CRLF breaks bash and the startup script).
* text=auto

*.sh     text eol=lf
*.tftpl  text eol=lf
*.tf     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
Caddyfile     text eol=lf
.env.example  text eol=lf
.terraform-version text eol=lf

# Windows binaries
*.png binary
*.jpg binary
